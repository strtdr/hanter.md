---
// hanter.md/test/comanda/: clientul își vede starea comenzii (după nr. comandă + ultimele 4 cifre ale telefonului).
// Stările se editează în TinaCMS (Test · Configurator → Stări comandă) și în coloana Status din tabelul „Comenzi”.
import '../../styles/test.css';
import cfg from '../../content/test/configurator.json';
import TopBar from '../../components/test/TopBar.astro';
import OrderTracker from '../../components/test/OrderTracker.astro';
import PageFooter from '../../components/test/PageFooter.astro';

const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const pageData = JSON.stringify({ base, cfg }).replace(/</g, '\\u003c');
---
<html lang="ro">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <title>Starea comenzii · Hanter.md</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Sofia+Sans+Extra+Condensed:wght@600;800&family=Manrope:wght@400;500;600;700&family=JetBrains+Mono:wght@500&display=swap" />
  </head>
  <body>
    <div class="wrap">
      <TopBar home={`${base}test/`} />
      <OrderTracker />
      <PageFooter />
    </div>
    <script id="hanter-data" type="application/json" is:inline set:html={pageData}></script>
    <script>
      import '../../scripts/test/track.js';
    </script>
  </body>
</html>
