---
// Straturile covorașului + tipurile de covoraș de protecție
import landing from '../../content/test/landing.json';
const m = landing.materials;
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const img = (p?: string) => (p ? base + p.replace(/^\//, '') : '');
---
<section class="blk" id="materiale">
  <h2>{m.title}</h2>
  <p class="sub2">{m.intro}</p>
  <div class="layers">
    <div class="stack" aria-hidden="true">
      {m.layers.map((_, i) => <div class={`ly l${Math.min(i + 1, 5)}`}><span>{i + 1}</span></div>)}
    </div>
    <ol class="lyl">
      {m.layers.map((ly) => <li><b>{ly.title}</b><span>{ly.text}</span></li>)}
    </ol>
  </div>
  <div class="prot-info">
    <div class="ph">
      <h3>{m.protectionTitle}</h3>
      <p>{m.protectionIntro}</p>
    </div>
    <div class="pcards">
      {m.protectionTypes.map((p) => (
        <figure class="pcard">
          {p.image && <img src={img(p.image)} alt={`Material real: ${p.title.toLowerCase()}`} loading="lazy" width="640" height="480" />}
          <figcaption><b>{p.title}</b><span>{p.text}</span></figcaption>
        </figure>
      ))}
    </div>
  </div>
</section>
